
@model List<UniEvent.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Users</h2>
            <p class="text-muted mb-0">
                View registered users and manage their roles.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-primary">
            Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Account Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>

                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">Admin</span>
                                        }
                                        else if (user.Role == "Organizer")
                                        {
                                            <span class="badge bg-primary">Organizer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @user.Role
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>

                                    
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            @if (user.Role == "Student" && user.IsActive)
                                            {
                                                <form asp-action="PromoteToOrganizer" method="post">
                                                    <input type="hidden" name="id" value="@user.Id" />

                                                    <button type="submit" class="btn btn-primary btn-sm">
                                                        Promote to Organizer
                                                    </button>
                                                </form>
                                            }

                                            @if (user.Role != "Admin")
                                            {
                                                <form asp-action="ToggleUserStatus" method="post">
                                                    <input type="hidden" name="id" value="@user.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm @(user.IsActive ? "btn-danger" : "btn-success")">
                                                        @(user.IsActive ? "Deactivate" : "Activate")
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Admin account</span>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No registered users found.
                </div>
            }

        </div>
    </div>

</div>
