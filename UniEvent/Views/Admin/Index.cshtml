
@model UniEvent.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Admin Dashboard</h2>

        <a asp-action="ManageUsers" class="btn btn-primary">
            Manage Users
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Total Users</h6>
                <h2>@Model.TotalUsers</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Total Events</h6>
                <h2>@Model.TotalEvents</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Pending Events</h6>
                <h2 class="text-warning">@Model.PendingEvents</h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm p-3">
                <h6>Approved Events</h6>
                <h2 class="text-success">@Model.ApprovedEvents</h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm p-3">
                <h6>Rejected Events</h6>
                <h2 class="text-danger">@Model.RejectedEvents</h2>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Events Awaiting Approval</h4>

    @if (Model.PendingEventList.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Organizer</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PendingEventList)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Organizer?.FullName</td>
                            <td>@item.Date.ToString("dd MMM yyyy")</td>
                            <td>@item.Venue</td>
                            <td>@item.Category</td>
                            <td>
                                <div class="d-flex gap-2">

                                    <form asp-action="ApproveEvent" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-success btn-sm">
                                            Approve
                                        </button>
                                    </form>

                                    <form asp-action="RejectEvent" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Reject
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            There are no pending events.
        </div>
    }
</div>
