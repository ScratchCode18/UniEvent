@model UniEvent.ViewModels.OrganizerDashboardViewModel

@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Organizer Dashboard</h2>
            <p class="text-muted">Manage your university events.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Create Event</a>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h6>Total Events</h6>
                <h2>@Model.TotalEvents</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h6>Pending</h6>
                <h2 class="text-warning">@Model.PendingEvents</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h6>Approved</h6>
                <h2 class="text-success">@Model.ApprovedEvents</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3">
                <h6>Rejected</h6>
                <h2 class="text-danger">@Model.RejectedEvents</h2>
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-3">My Events</h4>

    @if (!Model.MyEvents.Any())
    {
        <div class="alert alert-info">
            You haven't created any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover bg-white align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.MyEvents)
                    {
                        <tr>
                            <td>
                                <strong>@item.Title</strong>
                                <div class="text-muted small">@item.Category</div>
                            </td>
                            <td>@item.Date.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@item.Venue</td>
                            <td>
                                @if (item.Status == UniEvent.Models.EventStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == UniEvent.Models.EventStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">Edit</a>

                                <form asp-action="Delete" asp-route-id="@item.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
