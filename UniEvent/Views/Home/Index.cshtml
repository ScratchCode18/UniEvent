
@model UniEvent.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Welcome to UniEvent</h1>

        <p class="lead mt-3">
            Discover, organize, and participate in
            exciting university events.
        </p>

        <a href="#events" class="btn btn-light btn-lg mt-3">
            Explore Events
        </a>
    </div>
</section>

<section id="events" class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Upcoming Events</h2>

        <div>
            <label for="categoryFilter" class="form-label mb-1">
                Filter by Category
            </label>

            <select id="categoryFilter" class="form-select">
                <option value="all">All Categories</option>

                @foreach (var category in Model.UpcomingEvents
                    .Where(e => !string.IsNullOrWhiteSpace(e.Category))
                    .Select(e => e.Category!)
                    .Distinct()
                    .OrderBy(c => c))
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
    </div>

    <!-- AJAX Search Input -->
    <div class="mb-4">
        <label for="eventSearch" class="form-label">
            Search Events
        </label>

        <input type="text"
               id="eventSearch"
               class="form-control"
               placeholder="Search by event name, category or description..." />
    </div>

    <!-- AJAX Results Container -->
    <div class="row g-4" id="eventResults">
        @await Html.PartialAsync("_EventCards", Model.UpcomingEvents)
    </div>

</section>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Apply category filtering to currently displayed events
            function applyCategoryFilter() {

                const selectedCategory = $("#categoryFilter").val();

                $(".event-item").each(function () {

                    const eventCategory = $(this).data("category") || "";

                    if (
                        selectedCategory === "all" ||
                        eventCategory === selectedCategory
                    ) {
                        $(this).show();
                    }
                    else {
                        $(this).hide();
                    }
                });
            }

            // Dropdown Category Filter
            $("#categoryFilter").on("change", function () {
                applyCategoryFilter();
            });

            // AJAX GET - Live Event Search
            $("#eventSearch").on("input", function () {

                const searchTerm = $(this).val();

                $.get(
                    '@Url.Action("SearchEvents", "Home")',
                    { searchTerm: searchTerm },
                    function (data) {

                        $("#eventResults").html(data);

                        // Reapply category filter after AJAX update
                        applyCategoryFilter();
                    }
                );

            });

        });
    </script>
}
