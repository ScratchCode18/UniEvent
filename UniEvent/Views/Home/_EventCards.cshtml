
@model IEnumerable<UniEvent.Models.Event>

@if (Model.Any())
{
    @foreach (var eventItem in Model)
    {
        <div class="col-md-6 col-lg-4 event-item"
             data-category="@eventItem.Category">

            <div class="card event-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">

                    @if (!string.IsNullOrWhiteSpace(eventItem.Category))
                    {
                        <span class="badge bg-primary align-self-start mb-2">
                            @eventItem.Category
                        </span>
                    }

                    <h5 class="card-title fw-bold">
                        @eventItem.Title
                    </h5>

                    <p class="card-text">
                        @eventItem.Description
                    </p>

                    <div class="mt-auto">
                        <p class="mb-1">
                            <strong>Date:</strong>
                            @eventItem.Date.ToString("dd MMM yyyy")
                        </p>

                        <p class="mb-1">
                            <strong>Time:</strong>
                            @eventItem.Date.ToString("hh:mm tt")
                        </p>

                        <p class="mb-3">
                            <strong>Venue:</strong>
                            @eventItem.Venue
                        </p>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-primary">
                            Login to Register
                        </a>
                    </div>

                </div>
            </div>
        </div>
    }
}
else
{
    <div class="col-12 text-center py-5">
        <h5>No matching events found.</h5>
    </div>
}
